# =====================================================================
# SSS — Student Support System : environment configuration
# Save this file as ".env" in the MAIN PROJECT ROOT.
# NEVER commit your real .env file.
# =====================================================================

# ---- Application ----------------------------------------------------
APP_ENV=development
APP_NAME=SSS - Student Support System
SECRET_KEY=replace-with-your-own-secret-key
JWT_SECRET_KEY=replace-with-your-own-jwt-secret
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
BCRYPT_ROUNDS=12
APP_TIMEZONE=Asia/Kolkata
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database (MySQL 8) --------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sss_db
MYSQL_USER=sss_user
MYSQL_PASSWORD=YOUR_EXISTING_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=YOUR_EXISTING_MYSQL_ROOT_PASSWORD

# ---- Rate limiting --------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=300 per hour
RATELIMIT_STORAGE_URI=memory://

# ---- File uploads ---------------------------------------------------
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,webp

# ---- Email (SMTP) ---------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=SSS Student Support &lt;no-reply@example.com&gt;
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_MINUTES=10

# ---- SMS ------------------------------------------------------------
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_HTTP_ENDPOINT=
SMS_HTTP_API_KEY=
SMS_DEFAULT_COUNTRY_CODE=+91

# ---- Scheduler / reminders -----------------------------------------
SCHEDULER_ENABLED=true
REMINDER_RUN_HOUR=8
REMINDER_DAYS=30,15,7,3,1
DELIVERY_RETRY_INTERVAL_MINUTES=15

# ---- Initial admin --------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Frontend (Vite reads VITE_* from this root file) ---------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_MAPS_PROVIDER=osm